{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agc.example/schema/card.schema.json",
  "title": "Card",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "type", "cost", "text"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9\\-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["unit", "spell", "artifact", "location"]
    },
    "cost": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "text": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attack", "health"],
      "properties": {
        "attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "health": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "unit" } }
      },
      "then": {
        "required": ["stats"]
      }
    },
    {
      "if": {
        "properties": { "type": { "enum": ["spell", "artifact", "location"] } }
      },
      "then": {
        "not": { "required": ["stats"] }
      }
    }
  ]
}
